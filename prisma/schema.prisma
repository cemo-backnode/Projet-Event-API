generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         Int     @id @default(autoincrement())
  nom        String
  email      String  @unique
  motDePasse String
  role       Role
  dateInscription DateTime @default(now())

  organisateurEvenements Event[] @relation("Organisateur")
  reservations Booking[]
}

model Event {
  id             Int      @id @default(autoincrement())
  titre          String
  description    String?
  date           DateTime
  heureDebut     DateTime
  heureFin       DateTime
  lieu           String
  prix           Float
  capaciteMax    Int
  payant         Boolean  @default(false)
  organisateurId Int
  organisateur   User     @relation("Organisateur", fields: [organisateurId], references: [id])
  typeEvenementId Int?
  typeEvenement  EventType? @relation(fields: [typeEvenementId], references: [id])

  reservations   Booking[]
}

model EventType {
  id    Int    @id @default(autoincrement())
  nom   String @unique

  evenements Event[]
}

model Booking {
  id             Int      @id @default(autoincrement())
  eventId        Int
  participantId  Int
  statut         BookingStatus @default(en_attente)
  event          Event    @relation(fields: [eventId], references: [id])
  participant    User     @relation(fields: [participantId], references: [id])
  payment        Payment?
}

model Payment {
  id          Int     @id @default(autoincrement())
  bookingId   Int     @unique
  montant     Float
  methodePaiement String
  statut      PaymentStatus
  datePaiement DateTime @default(now())

  reservation Booking @relation(fields: [bookingId], references: [id])
}

enum Role {
  administrateur
  organisateur
  participant
}

enum BookingStatus {
  en_attente
  confirmee
  annulee
}

enum PaymentStatus {
  en_attente
  confirme
  echoue
  rembourse
}
